generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("PLATFORM_DATABASE_URL")
}

enum ChannelType {
  whatsapp
  instagram
  facebook
  email
}

enum MessageDirection {
  incoming
  outgoing
}

enum MessageStatus {
  received
  queued
  sent
  delivered
  failed
  mocked
}

enum ContentType {
  text
  html
  image
  file
  audio
  video
  template
  unknown
}

enum Role {
  SUPER_ADMIN
  ADMIN
  MANAGER
  AGENT
}

/// Login users (Google Auth)
model User {
  id           String   @id
  username     String   @unique // We'll map this to their email
  name         String?
  googleId     String?  @unique @map("google_id")
  role         Role     @default(AGENT)
  teamId       String?  @map("team_id")
  isActive     Boolean  @default(true) @map("is_active")
  createdById  String?  @map("created_by_id")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  team         Team?    @relation(fields: [teamId], references: [id])
  createdBy    User?    @relation("UserCreator", fields: [createdById], references: [id])
  createdUsers User[]   @relation("UserCreator")

  tickets      Ticket[] @relation("TicketAssignee")
  ticketsCreated Ticket[] @relation("TicketCreator")
  ticketNotes  TicketNote[] @relation("TicketNoteAuthor")
  
  // Teams where user is manager
  managedTeams Team[]   @relation("TeamManager")

  @@map("users")
}

model Team {
  id             String   @id
  name           String
  parentTeamId   String?  @map("parent_team_id")
  managerId      String?  @map("manager_id")
  createdAt      DateTime @default(now()) @map("created_at")

  parentTeam     Team?    @relation("TeamHierarchy", fields: [parentTeamId], references: [id])
  subTeams       Team[]   @relation("TeamHierarchy")
  
  manager        User?    @relation("TeamManager", fields: [managerId], references: [id])
  members        User[]
  tickets        Ticket[]

  @@map("teams")
}

/// Unified customer (person) across channels
model Customer {
  id        String   @id
  name      String?
  /// Free-form label used to group contacts for broadcasting (e.g. "vip", "newsletter", "promo")
  tag       String?
  /// True only when EVERY channel identity for this customer is resolved
  resolved  Boolean  @default(false)
  metadata  Json     @default("{}")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  whatsappIdentities  WhatsAppChannel[]
  instagramIdentities InstagramChannel[]
  facebookIdentities  FacebookChannel[]
  emailIdentities     EmailChannel[]
  tickets             Ticket[]

  @@index([resolved])
  @@index([tag])
  @@map("customers")
}

/// Provider connection settings (was inboxes)
model ChannelConfig {
  id            String      @id
  name          String
  channelType   ChannelType @map("channel_type")
  channelConfig Json        @default("{}") @map("channel_config")
  enabled       Boolean     @default(true)
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")

  webhookEvents WebhookEvent[]

  @@unique([channelType])
  @@index([enabled])
  @@map("channels_config")
}

/// Singleton Shopify vendor credentials (also editable in Settings)
model ShopifyConfig {
  id           String   @id @default("shopify_default")
  shop         String   @default("")
  clientId     String   @default("") @map("client_id")
  clientSecret String   @default("") @map("client_secret")
  metadata     Json     @default("{}")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("shopify_config")
}

/// One WhatsApp number / WA id for a customer
model WhatsAppChannel {
  id            String    @id
  customerId    String    @map("customer_id")
  externalId    String    @map("external_id")
  resolved      Boolean   @default(false)
  lastMessageAt DateTime? @map("last_message_at")
  lastCustomerMessageAt DateTime? @map("last_customer_message_at")
  metadata      Json      @default("{}")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([externalId])
  @@index([customerId])
  @@index([customerId, resolved])
  @@index([lastMessageAt])
  @@map("whatsapp_channel")
}

/// One Instagram scoped id for a customer
model InstagramChannel {
  id            String    @id
  customerId    String    @map("customer_id")
  externalId    String    @map("external_id")
  resolved      Boolean   @default(false)
  lastMessageAt DateTime? @map("last_message_at")
  lastCustomerMessageAt DateTime? @map("last_customer_message_at")
  metadata      Json      @default("{}")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([externalId])
  @@index([customerId])
  @@index([customerId, resolved])
  @@index([lastMessageAt])
  @@map("instagram_channel")
}

/// One Facebook Page-scoped ID (PSID) for a customer
model FacebookChannel {
  id            String    @id
  customerId    String    @map("customer_id")
  externalId    String    @map("external_id")
  resolved      Boolean   @default(false)
  lastMessageAt DateTime? @map("last_message_at")
  lastCustomerMessageAt DateTime? @map("last_customer_message_at")
  metadata      Json      @default("{}")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([externalId])
  @@index([customerId])
  @@index([customerId, resolved])
  @@index([lastMessageAt])
  @@map("facebook_channel")
}

/// One email address for a customer
model EmailChannel {
  id            String    @id
  customerId    String    @map("customer_id")
  externalId    String    @map("external_id")
  resolved      Boolean   @default(false)
  lastMessageAt DateTime? @map("last_message_at")
  lastCustomerMessageAt DateTime? @map("last_customer_message_at")
  metadata      Json      @default("{}")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([externalId])
  @@index([customerId])
  @@index([customerId, resolved])
  @@index([lastMessageAt])
  @@map("email_channel")
}

/// Messages hang off a channel identity (channelType + channelId)
model Message {
  id          String           @id
  channelType ChannelType      @map("channel_type")
  /// Id of whatsapp_channel / instagram_channel / email_channel row
  channelId   String           @map("channel_id")
  customerId  String           @map("customer_id")
  direction   MessageDirection
  content     String
  contentType ContentType      @default(text) @map("content_type")
  subject     String?
  externalId  String?          @map("external_id")
  /// Gmail thread id (email). Null for WhatsApp / Instagram.
  externalThreadId String?     @map("external_thread_id")
  status      MessageStatus    @default(received)
  rawPayload  Json?            @map("raw_payload")
  /// Agent has opened the thread since this message arrived (incoming only).
  isRead      Boolean          @default(false) @map("is_read")
  /// S3 object key for the primary / first media attachment.
  mediaKey    String?          @map("media_key")
  mediaMimeType String?        @map("media_mime_type")
  mediaFilename String?        @map("media_filename")
  /// All stored attachments: [{ mediaKey, mimeType, filename, contentType? }, ...]
  mediaItems  Json?            @map("media_items")
  createdAt   DateTime         @default(now()) @map("created_at")

  @@unique([channelType, channelId, externalId])
  @@index([customerId, channelType, isRead, direction])
  @@index([customerId, createdAt])
  @@index([channelType, channelId, createdAt])
  @@index([customerId, channelType])
  @@index([customerId, channelType, externalThreadId, createdAt])
  @@map("messages")
}

model WebhookEvent {
  id              String      @id
  channelConfigId String      @map("channel_config_id")
  channel         ChannelType
  eventKey        String      @map("event_key")
  payload         Json
  processed       Boolean     @default(false)
  createdAt       DateTime    @default(now()) @map("created_at")

  channelConfig ChannelConfig @relation(fields: [channelConfigId], references: [id], onDelete: Cascade)

  @@unique([channelConfigId, eventKey])
  @@index([channel, createdAt])
  @@map("webhook_events")
}

/// Inbound messages the agent removed — Pub/Sub/catch-up must not re-create them.
model SuppressedInbound {
  id          String      @id
  channelType ChannelType @map("channel_type")
  externalId  String      @map("external_id")
  customerId  String?     @map("customer_id")
  reason      String?
  createdAt   DateTime    @default(now()) @map("created_at")

  @@unique([channelType, externalId])
  @@index([customerId])
  @@map("suppressed_inbounds")
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  ESCALATED
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model Ticket {
  id          String         @id
  number      Int            @default(autoincrement())
  orgId       String?        @map("org_id")
  conversationId String?     @map("conversation_id")
  subject     String
  description String?
  status      TicketStatus   @default(OPEN)
  priority    TicketPriority @default(MEDIUM)
  channel     String?
  customerId  String?        @map("customer_id")
  
  assignedTo  String?        @map("assigned_to")
  assignee    User?          @relation("TicketAssignee", fields: [assignedTo], references: [id])
  
  teamId      String?        @map("team_id")
  team        Team?          @relation(fields: [teamId], references: [id])
  
  createdBy   String?        @map("created_by")
  creator     User?          @relation("TicketCreator", fields: [createdBy], references: [id])

  escalatedToUserId String?  @map("escalated_to_user_id")
  escalatedToTeamId String?  @map("escalated_to_team_id")

  resolvedAt  DateTime?      @map("resolved_at")
  closedAt    DateTime?      @map("closed_at")

  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")

  events      TicketEvent[]
  notes       TicketNote[]
  
  customer    Customer?      @relation(fields: [customerId], references: [id])

  @@index([status])
  @@index([assignedTo])
  @@index([teamId])
  @@index([createdBy])
  @@index([customerId])
  @@map("tickets")
}

enum TicketEventType {
  CREATED
  ASSIGNED
  REASSIGNED
  STATUS_CHANGED
  PRIORITY_CHANGED
  TEAM_CHANGED
  ESCALATED
  RETURNED
  NOTE_ADDED
  REPLIED
  RESOLVED
  CLOSED
  REOPENED
}

model TicketEvent {
  id          String          @id
  ticketId    String          @map("ticket_id")
  actorId     String?         @map("actor_id")
  type        TicketEventType
  fromValue   Json?           @map("from_value")
  toValue     Json?           @map("to_value")
  note        String?
  createdAt   DateTime        @default(now()) @map("created_at")

  ticket      Ticket          @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId])
  @@map("ticket_events")
}

model TicketNote {
  id          String    @id
  ticketId    String    @map("ticket_id")
  authorId    String    @map("author_id")
  body        String
  isInternal  Boolean   @default(true) @map("is_internal")
  createdAt   DateTime  @default(now()) @map("created_at")

  ticket      Ticket    @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author      User      @relation("TicketNoteAuthor", fields: [authorId], references: [id])

  @@index([ticketId])
  @@map("ticket_notes")
}

model FeatureFlag {
  key         String   @id
  enabled     Boolean  @default(false)
  description String?
  updatedAt   DateTime @updatedAt
}

model UserSession {
  id        String   @id @default(cuid())
  browser   String?
  os        String?
  userName  String?
  userEmail String?
  createdAt DateTime @default(now())
  events    SessionEvent[]
}

model SessionEvent {
  id        String   @id @default(cuid())
  sessionId String
  data      Json
  createdAt DateTime @default(now())
  session   UserSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
}

enum TemplateStatus {
  APPROVED
  PENDING
  REJECTED
  PAUSED
  DISABLED
  UNKNOWN
}

model WhatsAppTemplate {
  id               String         @id @default(cuid())
  wabaId           String?        @map("waba_id")
  metaTemplateId   String?        @map("meta_template_id")
  name             String
  language         String
  internalCategory String         @map("internal_category")
  metaCategory     String         @map("meta_category")
  status           TemplateStatus @default(PENDING)
  components       Json           @default("[]")
  rejectionReason  String?        @map("rejection_reason")
  qualityScore     String?        @map("quality_score")
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")
  lastSyncedAt     DateTime?      @map("last_synced_at")

  @@unique([name, language])
  @@map("whatsapp_templates")
}

model BroadcastJob {
  id           String               @id @default(cuid())
  templateId   String               @map("template_id")
  templateName String               @map("template_name")
  variables    Json                 @default("{}")
  status       String               @default("completed")
  total        Int
  succeeded    Int                  @default(0)
  failed       Int                  @default(0)
  createdAt    DateTime             @default(now()) @map("created_at")
  recipients   BroadcastRecipient[]

  @@map("broadcast_jobs")
}

model BroadcastRecipient {
  id           String       @id @default(cuid())
  jobId        String       @map("job_id")
  customerId   String       @map("customer_id")
  customerName String?      @map("customer_name")
  status       String
  error        String?
  messageId    String?      @map("message_id")
  deliveredAt  DateTime?    @map("delivered_at")
  readAt       DateTime?    @map("read_at")
  createdAt    DateTime     @default(now()) @map("created_at")
  job          BroadcastJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId])
  @@index([messageId])
  @@map("broadcast_recipients")
}
