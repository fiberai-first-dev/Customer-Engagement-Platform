generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("PLATFORM_DATABASE_URL")
}

enum ChannelType {
  whatsapp
  instagram
  email
}

enum ConversationStatus {
  open
  pending
  resolved
}

enum MessageDirection {
  incoming
  outgoing
}

enum MessageStatus {
  received
  queued
  sent
  delivered
  failed
  mocked
}

enum ContentType {
  text
  image
  file
  audio
  video
  unknown
}

/// Workspace / tenant
model Account {
  id        String   @id
  name      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  inboxes       Inbox[]
  contacts      Contact[]
  conversations Conversation[]

  @@map("accounts")
}

/// Channel connection (one WhatsApp number / IG page / mailbox per inbox)
model Inbox {
  id            String      @id
  accountId     String      @map("account_id")
  name          String
  channelType   ChannelType @map("channel_type")
  /// Provider credentials + webhook secrets (WhatsApp / Instagram / Email / Gmail)
  channelConfig Json        @default("{}") @map("channel_config")
  enabled       Boolean     @default(true)
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")

  account       Account        @relation(fields: [accountId], references: [id], onDelete: Cascade)
  conversations Conversation[]
  webhookEvents WebhookEvent[]

  @@index([accountId])
  @@index([channelType])
  @@index([accountId, channelType])
  @@map("inboxes")
}

/// Unified person across channels (one row; enable/update channel cols when linking same user)
model Contact {
  id        String   @id
  accountId String   @map("account_id")
  name      String?

  /// Display / search helpers (usually mirror channel ids)
  email String?
  phone String?

  whatsappEnabled Boolean @default(false) @map("whatsapp_enabled")
  whatsappId      String?  @map("whatsapp_id")
  /// Extra WA profile fields (display name, wa_id raw, etc.)
  whatsappDetails Json     @default("{}") @map("whatsapp_details")

  instagramEnabled Boolean @default(false) @map("instagram_enabled")
  instagramId      String?  @map("instagram_id")
  instagramDetails Json     @default("{}") @map("instagram_details")

  emailEnabled Boolean @default(false) @map("email_enabled")
  /// Channel external id for email (may match `email`)
  emailId      String?  @map("email_id")
  emailDetails Json     @default("{}") @map("email_details")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  account       Account        @relation(fields: [accountId], references: [id], onDelete: Cascade)
  conversations Conversation[]

  @@index([accountId])
  @@index([email])
  @@index([phone])
  @@index([accountId, whatsappId])
  @@index([accountId, instagramId])
  @@index([accountId, emailId])
  @@map("contacts")
}

/// Thread in one inbox with one contact
model Conversation {
  id               String             @id
  accountId        String             @map("account_id")
  inboxId          String             @map("inbox_id")
  contactId        String             @map("contact_id")
  status           ConversationStatus @default(open)
  /// Provider thread key (WA sender id, IG sender id, Gmail threadId, etc.)
  externalThreadId String?            @map("external_thread_id")
  lastMessageAt    DateTime?          @map("last_message_at")
  createdAt        DateTime           @default(now()) @map("created_at")
  updatedAt        DateTime           @updatedAt @map("updated_at")

  account  Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  inbox    Inbox    @relation(fields: [inboxId], references: [id], onDelete: Cascade)
  contact  Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  messages Message[]

  @@unique([inboxId, externalThreadId])
  @@index([accountId, status])
  @@index([accountId, lastMessageAt])
  @@index([inboxId])
  @@index([contactId])
  @@index([lastMessageAt])
  @@map("conversations")
}

model Message {
  id             String           @id
  conversationId String           @map("conversation_id")
  direction      MessageDirection
  content        String
  contentType    ContentType      @default(text) @map("content_type")
  subject        String?
  externalId     String?          @map("external_id")
  status         MessageStatus    @default(received)
  rawPayload     Json?            @map("raw_payload")
  createdAt      DateTime         @default(now()) @map("created_at")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@unique([conversationId, externalId])
  @@index([conversationId, createdAt])
  @@map("messages")
}

model WebhookEvent {
  id        String      @id
  inboxId   String      @map("inbox_id")
  channel   ChannelType
  eventKey  String      @map("event_key")
  payload   Json
  processed Boolean     @default(false)
  createdAt DateTime    @default(now()) @map("created_at")

  inbox Inbox @relation(fields: [inboxId], references: [id], onDelete: Cascade)

  @@unique([inboxId, eventKey])
  @@index([channel, createdAt])
  @@map("webhook_events")
}
