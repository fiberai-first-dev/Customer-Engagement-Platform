# Listen port inside the API process / container (Compose maps host → this port).
PLATFORM_PORT=4100

# Docker Compose sets DB + public URLs. Channel / Shopify / login live in Settings.
JWT_SECRET="dev-jwt-secret-do-not-use-in-prod-v2"

# WhatsApp media attachments (optional — required for send/receive images, video, audio, files)
# AWS_REGION=ap-south-1
# AWS_S3_BUCKET=your-cep-media-bucket
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# WHATSAPP_MEDIA_MAX_MB=100
