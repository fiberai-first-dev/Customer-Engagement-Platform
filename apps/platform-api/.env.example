# Core Platform Configuration
PLATFORM_PORT=4100
# Encode @ in passwords as %40.
#
# Docker Compose (API container → cep-postgres service):
PLATFORM_DATABASE_URL="postgresql://cep:cep@cep-postgres:5432/cep_platform"
PLATFORM_MIGRATE_DATABASE_URL="postgresql://cep:cep@cep-postgres:5432/cep_platform"
#
# Host machine / npm run outside Docker (published port 5434):
# PLATFORM_DATABASE_URL="postgresql://cep:cep@localhost:5434/cep_platform"
# PLATFORM_MIGRATE_DATABASE_URL="postgresql://cep:cep@localhost:5434/cep_platform"
#
PLATFORM_PUBLIC_BASE_URL="https://cep-api.logback-backend-services.online"
# Agent UI origin — OAuth Connect redirects vendors back to Settings
PLATFORM_WEB_BASE_URL="https://cep.logback-backend-services.online"

# Authentication
# Channel / Shopify / login secrets are NOT read from .env at runtime.
# Seed once (or let vendors configure in Settings UI):
#   npm run seed:user -- --username admin --password 'your-pass'
#   cp seed.creds.example.json seed.creds.json   # fill values
#   npm run seed:config
JWT_SECRET="dev-jwt-secret-do-not-use-in-prod-v2"
