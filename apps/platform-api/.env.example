# Core Platform Configuration
PLATFORM_PORT=4100
# Encode @ in passwords as %40. App may use pooler (:6543); migrations prefer session/direct (:5432).
PLATFORM_DATABASE_URL="postgresql://cep:cep@localhost:5434/cep_platform"
# PLATFORM_MIGRATE_DATABASE_URL="postgresql://cep:cep@localhost:5434/cep_platform"
PLATFORM_PUBLIC_BASE_URL="https://cep-api.logback-backend-services.online"
# Agent UI origin — OAuth Connect redirects vendors back to Settings
PLATFORM_WEB_BASE_URL="https://cep.logback-backend-services.online"


# Authentication & Security
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="password"
JWT_SECRET="dev-jwt-secret-do-not-use-in-prod-v2"


# Gmail Adapter Configuration
GMAIL_CLIENT_ID="your_google_oauth_client_id"
GMAIL_CLIENT_SECRET="your_google_oauth_client_secret"
# Required for send + Pub/Sub watch (inbox stays disabled until set)
GMAIL_REFRESH_TOKEN="your_oauth_refresh_token"
GMAIL_ACCESS_TOKEN=""
GMAIL_PUBSUB_TOPIC="projects/your-project/topics/gmail-events"

# After adding tokens: npm run seed && POST /api/v1/email/watch
# Pub/Sub push endpoint (stable): {PLATFORM_PUBLIC_BASE_URL}/webhooks/email/pubsub


# WhatsApp Cloud API Adapter Configuration
WHATSAPP_PHONE_NUMBER_ID="your_phone_number_id"
WHATSAPP_ACCESS_TOKEN="your_access_token"
WHATSAPP_VERIFY_TOKEN="your_verify_token"
WHATSAPP_APP_SECRET="your_app_secret"
WHATSAPP_BUSINESS_ACCOUNT_ID="your_business_account_id"


# Instagram Messaging Adapter Configuration
INSTAGRAM_PAGE_ID="your_page_id"
INSTAGRAM_ACCESS_TOKEN="your_access_token"
INSTAGRAM_VERIFY_TOKEN="your_verify_token"
INSTAGRAM_APP_SECRET="your_app_secret"
INSTAGRAM_APP_ID="your_app_id"
INSTAGRAM_USERNAME="your_username"
